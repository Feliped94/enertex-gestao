# Copie para .env (local) ou configure como variáveis de ambiente no provedor
# de hospedagem (Railway já injeta DATABASE_URL automaticamente ao linkar um
# banco Postgres ao serviço).

DATABASE_URL=postgres://usuario:senha@host:5432/banco
JWT_SECRET=troque-por-um-valor-aleatorio-longo
NODE_ENV=production
PORT=3000
